:global(*) { box-sizing: border-box; }

.dash { display: flex; min-height: 100vh; background: #0d1117; overflow-x: hidden; }

.sidebar { width: 210px; background: #0a0e14; border-right: 1px solid #1e2533; display: flex; flex-direction: column; flex-shrink: 0; height: 100vh; position: sticky; top: 0; z-index: 100; transition: transform 0.25s ease; }
.logoArea { padding: 16px; border-bottom: 1px solid #1e2533; display: flex; align-items: center; justify-content: center; }
.logoImg { width: 140px; height: auto; object-fit: contain; display: block; }
.nav { padding: 12px 0; flex: 1; }
.navItem { display: flex; align-items: center; gap: 10px; padding: 12px 18px; color: #8b9ab0; cursor: pointer; border-radius: 8px; margin: 2px 8px; transition: background 0.15s, color 0.15s; font-size: 14px; }
.navItem:hover { background: #141c28; color: #e8dfc8; }
.active { color: #c9a227; background: #141c28; }
.soonBadge { margin-left: auto; font-size: 9px; color: #c9a227; background: rgba(201,162,39,0.1); border: 1px solid rgba(201,162,39,0.2); border-radius: 4px; padding: 2px 6px; }
.turboBox { margin: 12px; padding: 14px; border-radius: 10px; background: #12100a; border: 1px solid #3d2f10; }
.turboLabel { font-size: 10px; color: #8b7a5a; }
.turboTitle { font-size: 18px; color: #c9a227; font-weight: 700; }
.turboDesc { font-size: 11px; color: #8b7a5a; margin: 8px 0; }
.turboBtn { width: 100%; padding: 8px; border: none; border-radius: 6px; background: #c9a227; color: #0d1117; font-weight: 700; cursor: pointer; }

.main { flex: 1; padding: 24px; overflow-x: hidden; }
.topBar { display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px; gap: 12px; }
.pageTitle { color: #e8dfc8; font-size: 32px; margin: 0; }
.pageSub { color: #6b7a8d; margin-top: 4px; font-size: 13px; }
.topRight { display: flex; align-items: center; gap: 12px; }
.btnNew { padding: 10px 18px; border-radius: 20px; border: 1px solid #c9a227; background: transparent; color: #c9a227; cursor: pointer; font-size: 13px; white-space: nowrap; }
.btnNew:hover { background: rgba(201,162,39,0.1); }
.userChip { display: flex; align-items: center; gap: 8px; background: #111820; border: 1px solid #1e2533; border-radius: 20px; padding: 4px 10px; }
.avatar { width: 28px; height: 28px; border-radius: 50%; background: #c9a227; color: black; display: flex; align-items: center; justify-content: center; font-size: 11px; font-weight: 700; }
.userName { color: #e8dfc8; font-size: 12px; }
.userRole { color: #6b7a8d; font-size: 10px; }
.hamburger { display: none; }
.overlay { display: none; }

.statsRow { display: flex; gap: 10px; margin-bottom: 16px; flex-wrap: wrap; }
.statChip { background: #111820; border: 1px solid #1e2533; border-radius: 10px; padding: 12px 18px; cursor: pointer; transition: all 0.15s; display: flex; flex-direction: column; align-items: center; min-width: 90px; }
.statChip:hover { border-color: #2e3f57; }
.statChipActive { border-color: #c9a227; background: rgba(201,162,39,0.08); }
.statChipNum { font-size: 22px; font-weight: 700; color: #e8dfc8; line-height: 1; }
.statChipLabel { font-size: 11px; color: #6b7a8d; margin-top: 4px; }

.agentFilter { display: flex; gap: 8px; margin-bottom: 20px; flex-wrap: wrap; }
.agentBtn { padding: 6px 12px; border-radius: 20px; border: 1px solid #1e2533; background: transparent; color: #8b9ab0; cursor: pointer; font-size: 12px; transition: all 0.15s; }
.agentBtn:hover { border-color: #2e3f57; color: #e8dfc8; }
.agentBtnActive { border-color: #c9a227; color: #c9a227; background: rgba(201,162,39,0.08); }

.taskList { display: flex; flex-direction: column; gap: 8px; }
.taskCard { background: #111820; border: 1px solid #1e2533; border-radius: 12px; padding: 14px 18px; display: flex; align-items: center; justify-content: space-between; gap: 12px; transition: border-color 0.15s; }
.taskCard:hover { border-color: #2e3f57; }
.taskDone { opacity: 0.5; }
.taskLeft { display: flex; align-items: center; gap: 14px; flex: 1; min-width: 0; }
.taskCheck { font-size: 20px; cursor: pointer; flex-shrink: 0; user-select: none; }
.taskTitle { color: #e8dfc8; font-size: 14px; font-weight: 500; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.taskDone .taskTitle { text-decoration: line-through; color: #6b7a8d; }
.taskMeta { display: flex; gap: 6px; font-size: 11px; color: #6b7a8d; margin-top: 3px; }
.taskRight { display: flex; align-items: center; gap: 10px; flex-shrink: 0; }
.priorityBadge { font-size: 10px; padding: 3px 8px; border-radius: 4px; border: 1px solid; font-weight: 500; }
.statusBadge { font-size: 11px; font-weight: 500; min-width: 70px; text-align: right; }
.deleteBtn { background: none; border: none; color: #3a4a5c; cursor: pointer; font-size: 14px; padding: 2px 6px; border-radius: 4px; }
.deleteBtn:hover { color: #e24b4b; background: rgba(226,75,75,0.1); }
.empty { text-align: center; color: #6b7a8d; padding: 40px; font-size: 14px; }

/* MODAL */
.modalOverlay { position: fixed; inset: 0; background: rgba(0,0,0,0.7); z-index: 1000; display: flex; align-items: center; justify-content: center; }
.modal { background: #111820; border: 1px solid #1e2533; border-radius: 16px; padding: 24px; width: 90%; max-width: 420px; }
.modalTitle { color: #e8dfc8; font-size: 18px; font-weight: 600; margin-bottom: 16px; }
.modalInput { width: 100%; background: #0d1117; border: 1px solid #2e3f57; border-radius: 8px; padding: 12px 14px; color: #e8dfc8; font-size: 14px; outline: none; margin-bottom: 12px; }
.modalInput:focus { border-color: #c9a227; }
.modalRow { display: flex; gap: 10px; margin-bottom: 16px; }
.modalSelect { flex: 1; background: #0d1117; border: 1px solid #2e3f57; border-radius: 8px; padding: 10px 12px; color: #e8dfc8; font-size: 13px; outline: none; cursor: pointer; }
.modalBtns { display: flex; gap: 10px; justify-content: flex-end; }
.modalCancel { padding: 10px 20px; border-radius: 8px; border: 1px solid #2e3f57; background: transparent; color: #8b9ab0; cursor: pointer; }
.modalConfirm { padding: 10px 20px; border-radius: 8px; border: none; background: #c9a227; color: #0d1117; font-weight: 700; cursor: pointer; }

@media (max-width: 768px) {
  .dash { display: block; position: relative; }
  .sidebar { position: fixed; left: 0; top: 0; height: 100vh; width: 240px; transform: translateX(-100%); z-index: 999; display: flex; }
  .sidebarOpen { transform: translateX(0); box-shadow: 4px 0 20px rgba(0,0,0,0.5); }
  .overlay { display: block; position: fixed; inset: 0; background: rgba(0,0,0,0); z-index: 998; pointer-events: none; transition: background 0.25s; }
  .overlayActive { background: rgba(0,0,0,0.6); pointer-events: auto; }
  .hamburger { display: flex; align-items: center; justify-content: center; width: 42px; height: 42px; border-radius: 8px; border: 1px solid #1e2533; background: #111820; color: white; font-size: 22px; cursor: pointer; flex-shrink: 0; }
  .main { padding: 14px; width: 100%; }
  .pageTitle { font-size: 22px; }
  .statsRow { gap: 8px; }
  .statChip { min-width: 70px; padding: 10px 12px; }
  .taskCard { flex-wrap: wrap; }
  .taskRight { width: 100%; justify-content: flex-end; }
  .statusBadge { display: none; }
}
